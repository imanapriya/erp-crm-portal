# Copy this file to .env and fill in real values before running the server.

# PostgreSQL connection string.
# Local example:   postgresql://postgres:postgres@localhost:5432/erp_crm?schema=public
# Supabase/Neon/Render Postgres will give you a connection string in this same format.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_crm?schema=public"

# Any long random string. Generate one with: openssl rand -base64 48
JWT_SECRET="replace-this-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"

PORT=4000
NODE_ENV=development

# The deployed/local frontend origin, for CORS.
CORS_ORIGIN="http://localhost:5173"
